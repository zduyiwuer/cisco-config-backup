# ============================================================
#  复制为 .env 后按需修改：cp .env.example .env
#  .env 已被 .gitignore 忽略，不要提交
# ============================================================

# 初始管理员密码（仅首次启动生效）
# 留空则自动生成随机密码，并打印在容器日志：
#   docker compose logs cisco-backup | grep -A3 "默认管理员"
CBS_ADMIN_PASSWORD=

# 映射到宿主机的端口（左侧）
CBS_PORT=8077

# 时区
TZ=Asia/Shanghai