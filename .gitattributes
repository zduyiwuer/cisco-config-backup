# 统一使用 LF 行尾符，避免 Linux 服务器上出现 CRLF 导致 shell 脚本无法执行
* text=auto eol=lf

# Windows 批处理文件保留 CRLF
*.bat text eol=crlf

# 二进制文件不处理
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.xlsx binary
*.db binary
*.key binary
*.pem binary

# 明确指定类型的文件
*.py    text eol=lf
*.js    text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.sh    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.conf  text eol=lf
*.example  text eol=lf
*.service text eol=lf
Dockerfile text eol=lf
.gitignore text eol=lf